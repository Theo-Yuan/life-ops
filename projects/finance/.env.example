# ===========================================
# 个人财富增长助手 — 环境变量
# 复制此文件为 .env 并填入真实值
# ===========================================

# 数据库路径（默认 .agents/db/finance.db）
# DB_PATH=

# --- API Keys（按需启用） ---

# 股票/基金行情 API（如新浪、东方财富）
# MARKET_API_KEY=

# 加密货币行情（如 CoinGecko API）
# CRYPTO_API_KEY=

# 汇率 API
# FX_API_KEY=
